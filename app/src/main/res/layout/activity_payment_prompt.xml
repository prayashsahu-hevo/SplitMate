<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ===== Header (always visible) ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_payment"
                    android:textAllCaps="true"
                    android:textColor="#6750A4"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#1D1B20"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    tools:text="₹500"
                    xmlns:tools="http://schemas.android.com/tools" />

                <TextView
                    android:id="@+id/tvVendor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#49454F"
                    android:textSize="16sp"
                    tools:text="to Big Bazaar"
                    xmlns:tools="http://schemas.android.com/tools" />

                <TextView
                    android:id="@+id/tvMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#79747E"
                    android:textSize="13sp"
                    tools:text="07 Jul 2026, 3:40 PM · Google Pay"
                    xmlns:tools="http://schemas.android.com/tools" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="#E7E0EC" />

                <!-- ===== Section: choose type ===== -->
                <LinearLayout
                    android:id="@+id/sectionChoose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/is_this"
                        android:textColor="#1D1B20"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPersonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/personal_expense"
                        android:textSize="16sp"
                        android:paddingVertical="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSplit"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/split_expense"
                        android:textSize="16sp"
                        android:paddingVertical="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDismiss"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/not_now" />
                </LinearLayout>

                <!-- ===== Section: personal ===== -->
                <LinearLayout
                    android:id="@+id/sectionPersonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/reason">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReasonPersonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category"
                        android:layout_marginTop="12dp"
                        android:textColor="#49454F" />

                    <Spinner
                        android:id="@+id/spCategoryPersonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSavePersonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/save_expense"
                        android:paddingVertical="14dp" />
                </LinearLayout>

                <!-- ===== Section: split input ===== -->
                <LinearLayout
                    android:id="@+id/sectionSplit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/how_many_people">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPeople"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbIncludeSelf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/include_my_share" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickContacts"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/pick_contacts" />

                    <TextView
                        android:id="@+id/tvSelectedContacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#49454F"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <!-- Dynamically filled with custom-name inputs for people without contacts -->
                    <LinearLayout
                        android:id="@+id/containerCustomNames"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/reason">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReasonSplit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category"
                        android:layout_marginTop="12dp"
                        android:textColor="#49454F" />

                    <Spinner
                        android:id="@+id/spCategorySplit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvSharePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="#6750A4"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Each person owes ₹100"
                        xmlns:tools="http://schemas.android.com/tools" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveSplit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/save_and_prepare_messages"
                        android:paddingVertical="14dp" />
                </LinearLayout>

                <!-- ===== Section: send messages ===== -->
                <LinearLayout
                    android:id="@+id/sectionSend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tap_each_to_send"
                        android:textColor="#1D1B20"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tap_send_hint"
                        android:textColor="#79747E"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp" />

                    <!-- One "Message X" button per participant, injected at runtime -->
                    <LinearLayout
                        android:id="@+id/containerSendButtons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDone"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/done" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</FrameLayout>
