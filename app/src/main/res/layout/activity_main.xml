<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sm_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ===== App header ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_gradient">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_wallet"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/sm_text"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/sm_text_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Setup card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/sm_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/sm_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView style="@style/SectionHeader" android:text="@string/setup" />

                <!-- Required: every prompt is a notification. -->
                <TextView
                    android:id="@+id/tvPostNotifStatus"
                    style="@style/StatusRow"
                    android:text="@string/perm_post_notif" />

                <!-- Required: this is what makes the prompt fire for every UPI app. -->
                <TextView
                    android:id="@+id/tvUsageStatus"
                    android:layout_marginTop="16dp"
                    style="@style/StatusRow"
                    android:text="@string/perm_usage" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUsage"
                    style="@style/Widget.SplitMate.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/grant_usage" />

                <!-- Optional: only fills in the amount automatically. -->
                <TextView
                    android:id="@+id/tvNotifStatus"
                    style="@style/StatusRow"
                    android:layout_marginTop="16dp"
                    android:text="@string/perm_notifications" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotif"
                    style="@style/Widget.SplitMate.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/grant_notifications" />

                <TextView
                    android:id="@+id/tvDetectionStatus"
                    style="@style/StatusRow"
                    android:layout_marginTop="16dp"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/tvContactsStatus"
                    style="@style/StatusRow"
                    android:layout_marginTop="16dp"
                    android:text="@string/perm_contacts" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContacts"
                    style="@style/Widget.SplitMate.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/grant_contacts" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Settings card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/sm_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/sm_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView style="@style/SectionHeader" android:text="@string/settings" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_script_url"
                    app:helperText="@string/help_script_url">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etScriptUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_own_name">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOwnName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_own_wa"
                    app:helperText="@string/help_own_wa">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOwnWa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_cc">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSettings"
                    style="@style/Widget.SplitMate.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/save_settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTest"
            style="@style/Widget.SplitMate.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/test_popup" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDebugLog"
            style="@style/Widget.SplitMate.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_debug_log" />
    </LinearLayout>
</ScrollView>
